# ==========================================
# MEDIA PORTAL - ENVIRONMENT CONFIGURATION
# ==========================================

# JSON Web Token Secret (Min 32 characters random string)
JWT_SECRET=

# PostgreSQL Database URL for Production (e.g. Supabase, Neon, Vercel Postgres)
DATABASE_URL=

# Vercel Blob Storage Token (Optional - for high capacity media uploads on Vercel)
BLOB_READ_WRITE_TOKEN=

# AWS S3 Storage Credentials (Optional - alternative cloud storage)
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_REGION=
AWS_S3_BUCKET=

# Default Initial Administrator Credentials
DEFAULT_ADMIN_USERNAME=admin
DEFAULT_ADMIN_EMAIL=admin@mediaportal.com
DEFAULT_ADMIN_PASSWORD=Admin@12345

# Gemini AI API Key (Optional for AI media description features)
GEMINI_API_KEY=

# Application Public Host URL
APP_URL=
